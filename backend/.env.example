# Round-0 Backend — Amazon Bedrock configuration
PORT=4000

# Credentials resolve through the standard AWS provider chain. Either point at a
# named profile, or export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN directly (what Workshop Studio hands you).
#
# Workshop tokens EXPIRE — often mid-interview. Paste a fresh triple into all
# three lines below and SAVE the file; candidates can tap Rejoin without restarting
# the backend (the server hot-reloads backend/.env on each reconnect).
# AWS_PROFILE=workshop
AWS_REGION=us-west-2

# Optional overrides.
# Claude needs the `us.` inference-profile prefix; bare model IDs are rejected.
# BEDROCK_EVALUATION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Nova Sonic is ON_DEMAND, so it takes the bare model ID and has no profile.
# BEDROCK_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
# Optional: Google search via Serper (better than DuckDuckGo HTML). Free tier at serper.dev
# SERPER_API_KEY=
# Set to false to skip web research during prepare
# WEB_RESEARCH_ENABLED=true
