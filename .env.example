# ── backend/.env ──────────────────────────────────────────────────────────────
# Runs entirely on Amazon Bedrock. No OpenAI key is used anywhere.
PORT=4000

# Credentials resolve through the normal AWS provider chain: either a profile…
AWS_PROFILE=your-profile
# …or the temporary triple (workshop/SSO credentials expire — a 403 usually
# means expiry rather than misconfiguration).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-west-2

# Optional overrides. Nova Sonic is ON_DEMAND only, so it takes the bare model
# id; Claude needs the `us.` inference-profile prefix.
# BEDROCK_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
# BEDROCK_SONIC_REGION=us-east-1
# BEDROCK_EVALUATION_MODEL_ID=us.anthropic.claude-sonnet-4-6
# BEDROCK_GENERATION_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Optional — enables the offline Context Pack fetch (read-only, allowlisted).
# CONFLUENCE_BASE_URL=https://<site>.atlassian.net
# CONFLUENCE_EMAIL=you@company.com
# CONFLUENCE_API_TOKEN=
# SLACK_BOT_TOKEN=xoxb-...

# ── frontend/.env.local ───────────────────────────────────────────────────────
# Inlined at build time, so it must be set before `next build` for any deploy.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
